---
import { Image } from 'astro:assets';
import type { Empresa } from '../datos/empresas';

/**
 * Cinta de empresas que pasa sola de derecha a izquierda. Se arma con dos
 * copias idénticas de la lista y se desplaza la mitad del ancho: al terminar
 * la vuelta la segunda copia queda donde estaba la primera y el salto no se
 * nota. Con pocas empresas la lista se repite hasta llenar pantallas anchas.
 * Se frena al pasar el mouse. Con "reducir movimiento" se oculta la cinta y
 * se muestra la lista quieta, una vez cada empresa.
 */
interface Props {
  empresas: Empresa[];
}

const { empresas } = Astro.props;

const MINIMO_POR_TANDA = 8;
const repeticiones = Math.max(1, Math.ceil(MINIMO_POR_TANDA / empresas.length));
const tanda = Array.from({ length: repeticiones }, () => empresas).flat();

const tarjeta =
  'tarjeta group flex w-60 shrink-0 flex-col items-center rounded-2xl border border-oliva/25 bg-papel px-5 py-6 text-center shadow-sm shadow-borravino/5 transition hover:-translate-y-1 hover:border-borravino/40 hover:shadow-md';
---

{/* Tarjeta: avatar recortado en círculo (se amplía un poco para ocultar el aro de Instagram), nombre, rubro y @usuario. */}
<div class="carrusel-empresas">
  <ul class="lista-quieta flex flex-wrap justify-center gap-5" aria-label="Empresas que confiaron en nosotros">
    {
      empresas.map((empresa) => (
        <li>
          <a
            class={tarjeta}
            href={empresa.instagram ? `https://www.instagram.com/${empresa.instagram}/` : undefined}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${empresa.nombre}${empresa.rubro ? `, ${empresa.rubro}` : ''} — ver en Instagram`}
          >
            {empresa.logo && (
              <span class="avatar"><Image src={empresa.logo} alt="" widths={[120, 240]} sizes="7rem" /></span>
            )}
            <span class="mt-4 font-display text-xl leading-tight font-semibold text-borravino">{empresa.nombre}</span>
            {empresa.rubro && <span class="epigrafe mt-1 text-xs">{empresa.rubro}</span>}
            {empresa.instagram && <span class="mt-3 max-w-full truncate text-sm text-oliva group-hover:text-borravino">@{empresa.instagram}</span>}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="ventana overflow-hidden py-3" aria-hidden="true">
    <div class="cinta flex w-max">
      {
        [0, 1].map(() => (
          <ul class="flex shrink-0 gap-5 pr-5">
            {tanda.map((empresa) => (
              <li>
                <a
                  class={tarjeta}
                  href={empresa.instagram ? `https://www.instagram.com/${empresa.instagram}/` : undefined}
                  target="_blank"
                  rel="noopener noreferrer"
                  tabindex="-1"
                >
                  {empresa.logo && (
                    <span class="avatar"><Image src={empresa.logo} alt="" widths={[120, 240]} sizes="7rem" /></span>
                  )}
                  <span class="mt-4 font-display text-xl leading-tight font-semibold text-borravino">{empresa.nombre}</span>
                  {empresa.rubro && <span class="epigrafe mt-1 text-xs">{empresa.rubro}</span>}
                  {empresa.instagram && <span class="mt-3 max-w-full truncate text-sm text-oliva group-hover:text-borravino">@{empresa.instagram}</span>}
                </a>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</div>

<style>
  .avatar {
    display: block;
    width: 7rem;
    height: 7rem;
    overflow: hidden;
    border-radius: 9999px;
    box-shadow: 0 0 0 3px var(--color-papel, #fff), 0 0 0 4px rgb(0 0 0 / 0.08);
  }

  .avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.24);
  }

  /* Con movimiento: la lista quieta queda solo para lectores de pantalla. */
  .lista-quieta {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .ventana {
    /* Bordes que se desvanecen para que las tarjetas entren y salgan suaves. */
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .cinta {
    animation: desplazar 40s linear infinite;
  }

  .ventana:hover .cinta {
    animation-play-state: paused;
  }

  @keyframes desplazar {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ventana {
      display: none;
    }

    .lista-quieta {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
      white-space: normal;
    }
  }
</style>
