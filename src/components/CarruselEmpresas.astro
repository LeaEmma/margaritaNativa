---
import { Image } from 'astro:assets';
import type { Empresa } from '../datos/empresas';

/**
 * Cinta de empresas que pasa sola de derecha a izquierda. Se arma con dos
 * copias idénticas de la lista y se desplaza la mitad del ancho: al terminar
 * la vuelta la segunda copia queda donde estaba la primera y el salto no se
 * nota. Con pocas empresas la lista se repite hasta llenar pantallas anchas.
 * Se frena al pasar el mouse. Con "reducir movimiento" se oculta la cinta y
 * se muestra la lista quieta, una vez cada empresa.
 */
interface Props {
  empresas: Empresa[];
}

const { empresas } = Astro.props;

const MINIMO_POR_TANDA = 8;
const repeticiones = Math.max(1, Math.ceil(MINIMO_POR_TANDA / empresas.length));
const tanda = Array.from({ length: repeticiones }, () => empresas).flat();

const tarjeta =
  'flex h-32 w-60 shrink-0 flex-col items-center justify-center rounded-xl border border-oliva/25 bg-papel px-6 text-center shadow-sm shadow-borravino/5';
---

<div class="carrusel-empresas">
  {/* La lista real: la leen los lectores de pantalla y es la que se ve sin movimiento. */}
  <ul class="lista-quieta flex flex-wrap justify-center gap-5" aria-label="Empresas que confiaron en nosotros">
    {
      empresas.map((empresa) => (
        <li class={tarjeta}>
          {empresa.logo ? (
            <Image src={empresa.logo} alt={empresa.nombre} class="max-h-20 w-auto object-contain" widths={[240, 480]} sizes="12rem" />
          ) : (
            <>
              <p class="font-display text-2xl leading-tight font-semibold text-borravino">{empresa.nombre}</p>
              {empresa.rubro && <p class="epigrafe mt-2 text-xs">{empresa.rubro}</p>}
            </>
          )}
        </li>
      ))
    }
  </ul>

  <div class="ventana overflow-hidden" aria-hidden="true">
    <div class="cinta flex w-max">
      {
        [0, 1].map(() => (
          <ul class="flex shrink-0 gap-5 pr-5">
            {tanda.map((empresa) => (
              <li class={tarjeta}>
                {empresa.logo ? (
                  <Image src={empresa.logo} alt="" class="max-h-20 w-auto object-contain" widths={[240, 480]} sizes="12rem" />
                ) : (
                  <>
                    <p class="font-display text-2xl leading-tight font-semibold text-borravino">{empresa.nombre}</p>
                    {empresa.rubro && <p class="epigrafe mt-2 text-xs">{empresa.rubro}</p>}
                  </>
                )}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</div>

<style>
  /* Con movimiento: la lista quieta queda solo para lectores de pantalla. */
  .lista-quieta {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .ventana {
    /* Bordes que se desvanecen para que las tarjetas entren y salgan suaves. */
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .cinta {
    animation: desplazar 40s linear infinite;
  }

  .ventana:hover .cinta {
    animation-play-state: paused;
  }

  @keyframes desplazar {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ventana {
      display: none;
    }

    .lista-quieta {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
      white-space: normal;
    }
  }
</style>
