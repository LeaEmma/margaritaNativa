---
import Icono from './Icono.astro';
import { SITIO } from '../datos/sitio';

/**
 * Pedido armado en el navegador, que se envía por WhatsApp.
 *
 * No cobra ni reserva stock a propósito: las flores son de estación y las
 * plantas salen del mercado, así que la disponibilidad se confirma al
 * responder. Lo que resuelve es que el pedido llegue detallado en vez de
 * "hola, quiero flores".
 *
 * Todo vive en localStorage: no hay servidor ni sesión.
 */
---

{
  SITIO.whatsapp && (
    <aside
      id="carrito"
      data-whatsapp={SITIO.whatsapp}
      hidden
      aria-label="Tu pedido"
      class="fixed inset-x-0 bottom-0 z-50 border-t border-oliva/30 bg-papel-claro/97 backdrop-blur-sm"
    >
      <div data-detalle hidden class="mx-auto max-w-3xl px-5 pt-4">
        <ul data-lista class="max-h-48 divide-y divide-oliva/20 overflow-y-auto" />

        <label class="mt-4 block">
          <span class="versalitas text-oliva">Tu nombre</span>
          <input
            type="text"
            data-cliente
            autocomplete="name"
            placeholder="Para saber con quién hablamos"
            class="mt-1.5 w-full rounded-lg border border-oliva/35 bg-papel px-4 py-2.5 text-tinta placeholder:text-oliva/60 focus:border-borravino focus:outline-none"
          />
        </label>
      </div>

      <div class="mx-auto flex max-w-3xl items-center gap-3 px-5 py-3 sm:gap-4">
        <button
          type="button"
          data-alternar
          aria-expanded="false"
          aria-controls="carrito-detalle"
          class="flex min-w-0 flex-1 items-baseline gap-2 text-left"
        >
          <span class="versalitas text-oliva">
            <span data-cuenta>0</span> <span data-palabra>productos</span>
          </span>
          <span class="font-display text-xl font-semibold text-borravino" data-total />
        </button>

        <button
          type="button"
          data-vaciar
          class="shrink-0 text-sm text-oliva underline underline-offset-4 transition-colors hover:text-borravino"
        >
          Vaciar
        </button>

        <a
          data-pedir
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="versalitas inline-flex shrink-0 items-center gap-2 rounded-full bg-borravino px-5 py-3 text-crema transition-colors hover:bg-borravino-medio"
        >
          <Icono nombre="whatsapp" class="h-5 w-5" />
          <span class="hidden sm:inline">Pedir por WhatsApp</span>
          <span class="sm:hidden">Pedir</span>
        </a>
      </div>
    </aside>
  )
}

<script>
  const CLAVE = 'margarita-nativa:pedido';
  const CLAVE_CLIENTE = 'margarita-nativa:cliente';

  type Linea = { slug: string; nombre: string; precio: number; cantidad: number };

  const raiz = document.querySelector<HTMLElement>('#carrito');
  if (raiz) iniciar(raiz);

  function iniciar(carrito: HTMLElement) {
    const lista = carrito.querySelector<HTMLUListElement>('[data-lista]')!;
    const detalle = carrito.querySelector<HTMLElement>('[data-detalle]')!;
    const alternar = carrito.querySelector<HTMLButtonElement>('[data-alternar]')!;
    const pedir = carrito.querySelector<HTMLAnchorElement>('[data-pedir]')!;
    const cliente = carrito.querySelector<HTMLInputElement>('[data-cliente]')!;
    const flotante = document.querySelector<HTMLElement>('#whatsapp-flotante');

    detalle.id = 'carrito-detalle';

    const plata = new Intl.NumberFormat('es-AR', {
      style: 'currency',
      currency: 'ARS',
      maximumFractionDigits: 0,
    });
    const precio = (v: number) => plata.format(v).replace(/\s/g, '');

    // localStorage puede fallar (ventana privada, cookies bloqueadas). Si falla,
    // el sitio tiene que seguir funcionando sin carrito y no romper la página.
    function leer(): Linea[] {
      try {
        const crudo = localStorage.getItem(CLAVE);
        const datos = crudo ? JSON.parse(crudo) : [];
        return Array.isArray(datos) ? datos.filter((l) => l?.slug && Number.isFinite(l.precio)) : [];
      } catch {
        return [];
      }
    }

    function guardar(lineas: Linea[]) {
      try {
        localStorage.setItem(CLAVE, JSON.stringify(lineas));
      } catch {
        /* sin persistencia, pero la sesión actual sigue andando */
      }
    }

    let pedido = leer();
    try {
      cliente.value = localStorage.getItem(CLAVE_CLIENTE) ?? '';
    } catch {
      /* sin persistencia: se escribe a mano cada vez */
    }

    cliente.addEventListener('input', () => {
      try {
        localStorage.setItem(CLAVE_CLIENTE, cliente.value.trim());
      } catch {
        /* idem */
      }
      pedir.href = `https://wa.me/${carrito.dataset.whatsapp}?text=${encodeURIComponent(mensaje())}`;
    });

    function mensaje(): string {
      const items = pedido
        .map((l) => `• ${l.cantidad} × ${l.nombre} — ${precio(l.precio * l.cantidad)}`)
        .join('\n');
      const total = pedido.reduce((s, l) => s + l.precio * l.cantidad, 0);
      // El número lo aporta WhatsApp; el nombre no, y sin él el pedido llega
      // de un desconocido. Si no lo cargaron, se manda igual.
      const nombre = cliente.value.trim();
      const saludo = nombre
        ? `¡Hola! Soy ${nombre} y quiero hacer un pedido:`
        : '¡Hola! Quiero hacer un pedido:';
      return `${saludo}\n\n${items}\n\nTotal: ${precio(total)}`;
    }

    function pintar() {
      const unidades = pedido.reduce((s, l) => s + l.cantidad, 0);
      const total = pedido.reduce((s, l) => s + l.precio * l.cantidad, 0);

      carrito.hidden = unidades === 0;
      // El flotante y la barra ocupan la misma esquina: con pedido abierto,
      // la barra ya ofrece el WhatsApp.
      if (flotante) flotante.hidden = unidades > 0;

      carrito.querySelector('[data-cuenta]')!.textContent = String(unidades);
      carrito.querySelector('[data-palabra]')!.textContent = unidades === 1 ? 'producto' : 'productos';
      carrito.querySelector('[data-total]')!.textContent = precio(total);

      lista.innerHTML = '';
      for (const linea of pedido) {
        const li = document.createElement('li');
        li.className = 'flex items-center gap-3 py-2.5';
        li.innerHTML = `
          <span class="min-w-0 flex-1 truncate text-oliva">${linea.nombre}</span>
          <span class="flex shrink-0 items-center gap-2">
            <button type="button" data-menos="${linea.slug}" aria-label="Quitar uno de ${linea.nombre}"
              class="h-7 w-7 rounded-full border border-oliva/40 text-oliva">−</button>
            <span class="w-5 text-center text-oliva">${linea.cantidad}</span>
            <button type="button" data-mas="${linea.slug}" aria-label="Agregar otro de ${linea.nombre}"
              class="h-7 w-7 rounded-full border border-oliva/40 text-oliva">+</button>
          </span>
          <span class="w-24 shrink-0 text-right font-display font-semibold text-oliva">${precio(linea.precio * linea.cantidad)}</span>`;
        lista.appendChild(li);
      }

      pedir.href = `https://wa.me/${carrito.dataset.whatsapp}?text=${encodeURIComponent(mensaje())}`;
    }

    function cambiar(slug: string, delta: number, datos?: Omit<Linea, 'cantidad'>) {
      const estabaVacio = pedido.length === 0;
      const existente = pedido.find((l) => l.slug === slug);
      if (existente) {
        existente.cantidad += delta;
        if (existente.cantidad <= 0) pedido = pedido.filter((l) => l.slug !== slug);
      } else if (delta > 0 && datos) {
        pedido.push({ ...datos, cantidad: delta });
      }
      guardar(pedido);
      // Al abrir el pedido se despliega el detalle una vez, así el campo del
      // nombre no queda escondido detrás de un botón que nadie toca.
      if (estabaVacio && pedido.length > 0) {
        detalle.hidden = false;
        alternar.setAttribute('aria-expanded', 'true');
      }
      pintar();
    }

    // Delegado en el documento: sirve para todas las filas sin registrar
    // un escuchador por producto.
    document.addEventListener('click', (evento) => {
      const objetivo = evento.target as HTMLElement;

      const agregar = objetivo.closest<HTMLButtonElement>('[data-agregar]');
      if (agregar) {
        cambiar(agregar.dataset.slug!, 1, {
          slug: agregar.dataset.slug!,
          nombre: agregar.dataset.nombre!,
          precio: Number(agregar.dataset.precio),
        });
        return;
      }

      const mas = objetivo.closest<HTMLButtonElement>('[data-mas]');
      if (mas) return cambiar(mas.dataset.mas!, 1);

      const menos = objetivo.closest<HTMLButtonElement>('[data-menos]');
      if (menos) return cambiar(menos.dataset.menos!, -1);
    });

    alternar.addEventListener('click', () => {
      const abierto = !detalle.hidden;
      detalle.hidden = abierto;
      alternar.setAttribute('aria-expanded', String(!abierto));
    });

    carrito.querySelector('[data-vaciar]')!.addEventListener('click', () => {
      pedido = [];
      guardar(pedido);
      detalle.hidden = true;
      alternar.setAttribute('aria-expanded', 'false');
      pintar();
    });

    pintar();
  }
</script>
