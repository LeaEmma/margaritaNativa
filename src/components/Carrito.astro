---
import Icono from './Icono.astro';
import Ornamento from './Ornamento.astro';
import { SITIO } from '../datos/sitio';

/**
 * Pedido armado en el navegador, que se envía por WhatsApp.
 *
 * No cobra ni reserva stock a propósito: las flores son de estación y las
 * plantas salen del mercado, así que la disponibilidad se confirma al
 * responder. Lo que resuelve es que el pedido llegue detallado en vez de
 * "hola, quiero flores".
 *
 * Es un cajón lateral y no una barra inferior porque la barra tapaba el
 * catálogo justo mientras se elige, que es cuando más se lo necesita ver.
 *
 * Todo vive en localStorage: no hay servidor ni sesión.
 */
---

{
  SITIO.whatsapp && (
    <>
      {/* Lanzador: reemplaza al flotante de WhatsApp mientras haya pedido */}
      <button
        type="button"
        id="carrito-lanzador"
        hidden
        data-abrir-carrito
        aria-controls="carrito"
        aria-expanded="false"
        class="fixed right-5 bottom-[max(1.25rem,env(safe-area-inset-bottom))] z-40 flex h-14 w-14 items-center justify-center rounded-full bg-borravino text-crema shadow-lg shadow-borravino/25 transition-transform hover:scale-105 hover:bg-borravino-medio sm:h-16 sm:w-16"
      >
        <span class="sr-only">Abrir tu pedido</span>
        <Icono nombre="bolsa" class="h-7 w-7 sm:h-8 sm:w-8" />
        <span
          data-insignia-carrito
          class="absolute -top-1 -right-1 flex h-6 min-w-6 items-center justify-center rounded-full border-2 border-papel bg-oliva px-1 text-xs font-semibold text-crema"
        >
          0
        </span>
      </button>

      {/* Fondo */}
      <div
        id="carrito-fondo"
        class="pointer-events-none fixed inset-0 z-40 bg-tinta/50 opacity-0 transition-opacity duration-300"
      />

      {/* Cajón. El contenedor del tamaño de la pantalla recorta el cajón
          cuando está cerrado: si no, en los celulares el cajón escondido a la
          derecha agranda la página y aparece desplazamiento horizontal. */}
      <div class="pointer-events-none fixed inset-0 z-50 overflow-hidden">
      <aside
        id="carrito"
        role="dialog"
        aria-modal="true"
        aria-labelledby="carrito-titulo"
        aria-hidden="true"
        data-whatsapp={SITIO.whatsapp}
        class="pointer-events-auto absolute inset-y-0 right-0 flex h-dvh w-full max-w-sm translate-x-full flex-col border-l border-oliva/30 bg-papel-claro shadow-2xl transition-transform duration-300 ease-out"
      >
        <header class="flex items-center justify-between gap-4 border-b border-oliva/25 px-5 py-4">
          <h2 id="carrito-titulo" class="font-display text-xl font-semibold tracking-wide text-borravino uppercase">
            Tu pedido
          </h2>
          <button
            type="button"
            data-cerrar
            class="flex h-9 w-9 items-center justify-center rounded-full text-oliva transition-colors hover:bg-oliva/10 hover:text-borravino"
          >
            <span class="sr-only">Cerrar</span>
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" />
            </svg>
          </button>
        </header>

        <ul data-lista class="flex-1 divide-y divide-oliva/20 overflow-y-auto px-5" />

        {/* Se puede abrir el pedido vacío desde el menú: sin esto queda un hueco. */}
        <div data-vacio hidden class="flex flex-1 flex-col items-center justify-center px-8 text-center">
          <Ornamento />
          <p class="font-display mt-5 text-xl font-semibold tracking-wide text-borravino uppercase">
            Todavía no elegiste nada
          </p>
          <p class="mt-3 text-balance text-oliva">
            Las flores cambian con la estación: lo que hay esta semana no es lo que va a haber
            en la próxima.
          </p>
          <a
            href="/catalogo"
            class="versalitas mt-7 inline-flex items-center justify-center rounded-full border border-borravino/40 px-6 py-3 text-borravino transition-colors hover:border-borravino hover:bg-borravino/5"
          >
            Ver el catálogo
          </a>
        </div>

        <footer
          data-controles
          class="border-t border-oliva/25 px-5 pt-5 pb-[max(1.25rem,env(safe-area-inset-bottom))]"
        >
          <label class="block">
            <span class="versalitas text-oliva">
              Tu nombre <span aria-hidden="true" class="text-borravino">*</span>
            </span>
            <input
              type="text"
              data-cliente
              required
              autocomplete="name"
              aria-describedby="carrito-error"
              placeholder="Para saber con quién hablamos"
              class="mt-1.5 w-full rounded-lg border border-oliva/35 bg-papel px-4 py-2.5 text-tinta placeholder:text-oliva/60 focus:border-borravino focus:outline-none"
            />
          </label>
          <p id="carrito-error" data-error hidden class="mt-2 text-sm text-borravino">
            Escribí tu nombre así sabemos con quién hablamos.
          </p>

          <div class="mt-5 flex items-baseline justify-between gap-4">
            <span class="versalitas text-oliva">Total</span>
            <span class="font-display text-2xl font-semibold text-borravino" data-total />
          </div>

          <a
            data-pedir
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="versalitas mt-4 flex w-full items-center justify-center gap-2.5 rounded-full bg-borravino px-5 py-3.5 text-crema transition-colors hover:bg-borravino-medio aria-disabled:cursor-not-allowed aria-disabled:bg-borravino/40"
          >
            <Icono nombre="whatsapp" class="h-5 w-5" />
            Pedir por WhatsApp
          </a>

          {/* Al agregar algo el cajón se abre solo: sin esto, para volver al
              catálogo había que descubrir la cruz de arriba. */}
          <button
            type="button"
            data-seguir
            class="versalitas mt-3 flex w-full items-center justify-center rounded-full border border-borravino/40 px-5 py-3 text-borravino transition-colors hover:border-borravino hover:bg-borravino/5"
          >
            Seguir eligiendo
          </button>

          <button
            type="button"
            data-vaciar
            class="mt-3 w-full text-sm text-oliva underline underline-offset-4 transition-colors hover:text-borravino"
          >
            Vaciar pedido
          </button>
        </footer>
      </aside>
      </div>
    </>
  )
}

<script>
  const CLAVE = 'margarita-nativa:pedido';
  const CLAVE_CLIENTE = 'margarita-nativa:cliente';

  type Linea = { slug: string; nombre: string; precio: number; cantidad: number };

  const raiz = document.querySelector<HTMLElement>('#carrito');
  if (raiz) iniciar(raiz);

  function iniciar(carrito: HTMLElement) {
    const fondo = document.querySelector<HTMLElement>('#carrito-fondo')!;
    const lanzador = document.querySelector<HTMLButtonElement>('#carrito-lanzador')!;
    const flotante = document.querySelector<HTMLElement>('#whatsapp-flotante');
    const lista = carrito.querySelector<HTMLUListElement>('[data-lista]')!;
    const cliente = carrito.querySelector<HTMLInputElement>('[data-cliente]')!;
    const error = carrito.querySelector<HTMLElement>('[data-error]')!;
    const pedir = carrito.querySelector<HTMLAnchorElement>('[data-pedir]')!;
    // El indicador vive tambien en el menu, asi que hay mas de uno.
    const insignias = document.querySelectorAll<HTMLElement>('[data-insignia-carrito]');
    const disparadores = document.querySelectorAll<HTMLButtonElement>('[data-abrir-carrito]');

    const plata = new Intl.NumberFormat('es-AR', {
      style: 'currency',
      currency: 'ARS',
      maximumFractionDigits: 0,
    });
    const precio = (v: number) => plata.format(v).replace(/\s/g, '');

    // El pedido se guarda en localStorage y vuelve a la página como HTML: se
    // escapa para que un valor alterado ahí no pueda inyectar código.
    const escapar = (texto: string) =>
      String(texto).replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

    // localStorage puede fallar (ventana privada, cookies bloqueadas). Si falla,
    // el sitio tiene que seguir andando sin carrito en vez de romperse.
    function leer(): Linea[] {
      try {
        const crudo = localStorage.getItem(CLAVE);
        const datos = crudo ? JSON.parse(crudo) : [];
        return Array.isArray(datos) ? datos.filter((l) => l?.slug && Number.isFinite(l.precio)) : [];
      } catch {
        return [];
      }
    }

    function guardar(lineas: Linea[]) {
      try {
        localStorage.setItem(CLAVE, JSON.stringify(lineas));
      } catch {
        /* sin persistencia, pero la sesión actual sigue andando */
      }
    }

    let pedido = leer();
    try {
      cliente.value = localStorage.getItem(CLAVE_CLIENTE) ?? '';
    } catch {
      /* se escribe a mano cada vez */
    }

    const conNombre = () => cliente.value.trim().length > 0;

    function mensaje(): string {
      const items = pedido
        .map((l) => `• ${l.cantidad} × ${l.nombre} — ${precio(l.precio * l.cantidad)}`)
        .join('\n');
      const total = pedido.reduce((s, l) => s + l.precio * l.cantidad, 0);
      // El número lo aporta WhatsApp; el nombre no, y sin él el pedido llega
      // de un desconocido.
      const saludo = `¡Hola! Soy ${cliente.value.trim()} y quiero hacer un pedido:`;
      return `${saludo}\n\n${items}\n\nTotal: ${precio(total)}`;
    }

    function pintarPedir() {
      const listo = conNombre() && pedido.length > 0;
      pedir.setAttribute('aria-disabled', String(!listo));
      pedir.href = listo
        ? `https://wa.me/${carrito.dataset.whatsapp}?text=${encodeURIComponent(mensaje())}`
        : '#';
      if (listo) error.hidden = true;
    }

    function pintar() {
      const unidades = pedido.reduce((s, l) => s + l.cantidad, 0);
      const total = pedido.reduce((s, l) => s + l.precio * l.cantidad, 0);

      lanzador.hidden = unidades === 0;
      for (const marca of insignias) {
        marca.textContent = String(unidades);
        marca.hidden = unidades === 0;
      }
      // El lanzador y el flotante comparten esquina.
      if (flotante) flotante.hidden = unidades > 0;
      carrito.querySelector('[data-total]')!.textContent = precio(total);

      lista.innerHTML = '';
      for (const linea of pedido) {
        const li = document.createElement('li');
        li.className = 'flex items-center gap-3 py-3';
        li.innerHTML = `
          <span class="min-w-0 flex-1">
            <span class="block truncate text-tinta">${escapar(linea.nombre)}</span>
            <span class="text-sm text-oliva">${precio(linea.precio)} c/u</span>
          </span>
          <span class="flex shrink-0 items-center gap-1.5">
            <button type="button" data-menos="${escapar(linea.slug)}" aria-label="Quitar uno de ${escapar(linea.nombre)}"
              class="h-8 w-8 rounded-full border border-oliva/40 text-oliva transition-colors hover:border-borravino hover:text-borravino">−</button>
            <span class="w-6 text-center text-tinta">${Number(linea.cantidad)}</span>
            <button type="button" data-mas="${escapar(linea.slug)}" aria-label="Agregar otro de ${escapar(linea.nombre)}"
              class="h-8 w-8 rounded-full border border-oliva/40 text-oliva transition-colors hover:border-borravino hover:text-borravino">+</button>
          </span>
          <span class="font-display w-20 shrink-0 text-right font-semibold text-oliva">${precio(linea.precio * linea.cantidad)}</span>`;
        lista.appendChild(li);
      }

      // Con el pedido vacío el cajón sigue abierto mostrando el estado vacío:
      // cerrarlo de golpe al vaciar se siente como que algo falló.
      const vacio = pedido.length === 0;
      lista.hidden = vacio;
      carrito.querySelector<HTMLElement>('[data-vacio]')!.hidden = !vacio;
      carrito.querySelector<HTMLElement>('[data-controles]')!.hidden = vacio;

      pintarPedir();
    }

    /* ----------------------------- apertura ----------------------------- */

    let devolverFocoA: HTMLElement | null = null;

    const estaAbierto = () => carrito.getAttribute('aria-hidden') === 'false';

    function abrir() {
      devolverFocoA = document.activeElement as HTMLElement;
      carrito.setAttribute('aria-hidden', 'false');
      carrito.classList.remove('translate-x-full');
      fondo.classList.remove('pointer-events-none', 'opacity-0');
      for (const d of disparadores) d.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      carrito.querySelector<HTMLButtonElement>('[data-cerrar]')!.focus();
    }

    function cerrar() {
      if (!estaAbierto()) return;
      carrito.setAttribute('aria-hidden', 'true');
      carrito.classList.add('translate-x-full');
      fondo.classList.add('pointer-events-none', 'opacity-0');
      for (const d of disparadores) d.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      devolverFocoA?.focus();
    }

    for (const d of disparadores) d.addEventListener('click', abrir);
    fondo.addEventListener('click', cerrar);
    carrito.querySelector('[data-cerrar]')!.addEventListener('click', cerrar);
    carrito.querySelector('[data-seguir]')!.addEventListener('click', cerrar);

    document.addEventListener('keydown', (evento) => {
      if (!estaAbierto()) return;
      if (evento.key === 'Escape') return cerrar();

      // Mientras el cajón es modal, el foco no debería salirse por detrás.
      if (evento.key !== 'Tab') return;
      const focolables = carrito.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), input, [tabindex]:not([tabindex="-1"])',
      );
      if (!focolables.length) return;
      const primero = focolables[0]!;
      const ultimo = focolables[focolables.length - 1]!;
      if (evento.shiftKey && document.activeElement === primero) {
        evento.preventDefault();
        ultimo.focus();
      } else if (!evento.shiftKey && document.activeElement === ultimo) {
        evento.preventDefault();
        primero.focus();
      }
    });

    /* ------------------------------ acciones ---------------------------- */

    function cambiar(slug: string, delta: number, datos?: Omit<Linea, 'cantidad'>) {
      const existente = pedido.find((l) => l.slug === slug);
      if (existente) {
        existente.cantidad += delta;
        if (existente.cantidad <= 0) pedido = pedido.filter((l) => l.slug !== slug);
      } else if (delta > 0 && datos) {
        pedido.push({ ...datos, cantidad: delta });
      }
      guardar(pedido);
      pintar();
    }

    // Delegado en el documento: sirve para todas las filas sin registrar un
    // escuchador por producto.
    document.addEventListener('click', (evento) => {
      const objetivo = evento.target as HTMLElement;

      const agregar = objetivo.closest<HTMLButtonElement>('[data-agregar]');
      if (agregar) {
        cambiar(agregar.dataset.slug!, 1, {
          slug: agregar.dataset.slug!,
          nombre: agregar.dataset.nombre!,
          precio: Number(agregar.dataset.precio),
        });
        abrir();
        return;
      }

      const mas = objetivo.closest<HTMLButtonElement>('[data-mas]');
      if (mas) return cambiar(mas.dataset.mas!, 1);

      const menos = objetivo.closest<HTMLButtonElement>('[data-menos]');
      if (menos) return cambiar(menos.dataset.menos!, -1);
    });

    cliente.addEventListener('input', () => {
      try {
        localStorage.setItem(CLAVE_CLIENTE, cliente.value.trim());
      } catch {
        /* idem */
      }
      pintarPedir();
    });

    // El enlace sigue siendo un enlace, pero sin nombre no se deja salir:
    // deshabilitarlo a secas dejaría a la persona sin saber qué falta.
    pedir.addEventListener('click', (evento) => {
      if (conNombre() && pedido.length > 0) return;
      evento.preventDefault();
      error.hidden = false;
      cliente.focus();
    });

    carrito.querySelector('[data-vaciar]')!.addEventListener('click', () => {
      pedido = [];
      guardar(pedido);
      pintar();
    });

    pintar();
  }
</script>
