---
import Icono from './Icono.astro';
import type { Resena } from '../datos/resenas';

/**
 * Carrusel de opiniones. Es una fila con desplazamiento horizontal que encaja
 * tarjeta por tarjeta (scroll-snap), así en el celular se pasa con el dedo sin
 * código extra. El script la hace avanzar sola cada pocos segundos y vuelve
 * al principio al llegar al final; se frena mientras el mouse, el dedo o el
 * foco del teclado están encima, y con "reducir movimiento" no avanza sola.
 * Las flechas funcionan siempre.
 */
interface Props {
  resenas: Resena[];
}

const { resenas } = Astro.props;

const flecha =
  'flex h-11 w-11 items-center justify-center rounded-full border border-borravino/30 text-borravino transition-colors hover:border-borravino hover:bg-borravino/5';
---

<div class="carrusel-resenas" data-carrusel-resenas>
  <ul
    class="pista flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth scroll-px-5 px-5 pb-2 sm:scroll-px-0 sm:px-0"
    aria-label="Opiniones de clientes"
    tabindex="0"
  >
    {
      resenas.map((resena) => (
        <li class="flex w-[85%] shrink-0 snap-start sm:w-[calc((100%-1.25rem)/2)] lg:w-[calc((100%-2.5rem)/3)]">
          <figure class="flex w-full flex-col rounded-2xl border border-oliva/25 bg-papel p-7 shadow-sm shadow-borravino/5">
            <div class="flex gap-0.5 text-borravino" role="img" aria-label="5 estrellas">
              {[1, 2, 3, 4, 5].map(() => (
                <Icono nombre="estrella" class="h-4 w-4 fill-current" />
              ))}
            </div>
            <blockquote class="mt-4 flex-1 font-display text-lg leading-relaxed text-tinta">
              <p>“{resena.cita}”</p>
            </blockquote>
            <figcaption class="mt-6 border-t border-oliva/20 pt-4">
              <p class="font-display text-lg font-semibold text-borravino">{resena.nombre}</p>
              <p class="epigrafe mt-1 text-xs">{resena.producto}</p>
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>

  <div class="mt-8 flex justify-center gap-3">
    <button type="button" class={flecha} data-anterior aria-label="Opinión anterior">
      <svg viewBox="0 0 20 20" class="h-5 w-5 fill-current" aria-hidden="true">
        <path d="M12.7 4.3 7 10l5.7 5.7-1.4 1.4L4.2 10l7.1-7.1Z" />
      </svg>
    </button>
    <button type="button" class={flecha} data-siguiente aria-label="Opinión siguiente">
      <svg viewBox="0 0 20 20" class="h-5 w-5 fill-current" aria-hidden="true">
        <path d="M7.3 15.7 13 10 7.3 4.3l1.4-1.4 7.1 7.1-7.1 7.1Z" />
      </svg>
    </button>
  </div>
</div>

<style>
  .pista {
    scrollbar-width: none;
  }

  .pista::-webkit-scrollbar {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .pista {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  const INTERVALO = 6000;
  const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-carrusel-resenas]').forEach((carrusel) => {
    const pista = carrusel.querySelector<HTMLElement>('.pista')!;
    const tarjetas = Array.from(pista.children) as HTMLElement[];

    // Distancia de una tarjeta más el espacio entre tarjetas.
    const paso = () =>
      tarjetas.length > 1 ? tarjetas[1].offsetLeft - tarjetas[0].offsetLeft : pista.clientWidth;

    const alFinal = () => pista.scrollLeft + pista.clientWidth >= pista.scrollWidth - 4;
    const alPrincipio = () => pista.scrollLeft <= 4;

    const avanzar = () => {
      if (alFinal()) pista.scrollTo({ left: 0 });
      else pista.scrollBy({ left: paso() });
    };

    const retroceder = () => {
      if (alPrincipio()) pista.scrollTo({ left: pista.scrollWidth });
      else pista.scrollBy({ left: -paso() });
    };

    carrusel.querySelector('[data-siguiente]')!.addEventListener('click', avanzar);
    carrusel.querySelector('[data-anterior]')!.addEventListener('click', retroceder);

    // Avance automático: solo con la sección a la vista, la pestaña activa y
    // nadie interactuando con el carrusel.
    let visible = false;
    let ocupado = false;
    let temporizador: number | undefined;

    const reiniciar = () => {
      window.clearInterval(temporizador);
      temporizador = undefined;
      if (visible && !ocupado && !sinMovimiento.matches && !document.hidden) {
        temporizador = window.setInterval(avanzar, INTERVALO);
      }
    };

    new IntersectionObserver(([entrada]) => {
      visible = entrada.isIntersecting;
      reiniciar();
    }, { threshold: 0.4 }).observe(carrusel);

    const ocupar = () => {
      ocupado = true;
      reiniciar();
    };
    const liberar = () => {
      ocupado = false;
      reiniciar();
    };

    carrusel.addEventListener('mouseenter', ocupar);
    carrusel.addEventListener('mouseleave', liberar);
    carrusel.addEventListener('focusin', ocupar);
    carrusel.addEventListener('focusout', (evento) => {
      if (!carrusel.contains(evento.relatedTarget as Node | null)) liberar();
    });
    // En el celular: se frena al tocar y retoma un rato después de soltar.
    pista.addEventListener('touchstart', ocupar, { passive: true });
    pista.addEventListener('touchend', () => window.setTimeout(liberar, INTERVALO), { passive: true });

    document.addEventListener('visibilitychange', reiniciar);
    sinMovimiento.addEventListener('change', reiniciar);
  });
</script>
