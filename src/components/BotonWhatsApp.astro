---
import Icono from './Icono.astro';
import { SITIO, enlaceContacto } from '../datos/sitio';

/**
 * Botón flotante de WhatsApp. Se mantiene en borravino en vez del verde de
 * WhatsApp: el verde sería el único de la paleta y chocaría con el oliva.
 * Solo se renderiza si hay número cargado en datos/sitio.ts.
 */
interface Props {
  /**
   * Mensaje prearmado. Cada página pasa el suyo para que el mensaje llegue
   * diciendo desde dónde escriben: si alguien consulta leyendo los cuidados
   * de una planta, el nombre de esa planta tiene que viajar en el mensaje.
   */
  mensaje?: string;
}

const { mensaje = '¡Hola! Te escribo desde la web.' } = Astro.props;
---

{
  SITIO.whatsapp && (
    <a
      id="whatsapp-flotante"
      href={enlaceContacto(mensaje)}
      target="_blank"
      rel="noopener noreferrer"
      class="fixed right-5 bottom-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-borravino text-crema shadow-lg shadow-borravino/25 transition-transform hover:scale-105 hover:bg-borravino-medio sm:h-16 sm:w-16"
      aria-label="Escribinos por WhatsApp"
    >
      <Icono nombre="whatsapp" class="h-7 w-7 sm:h-8 sm:w-8" />
    </a>
  )
}
