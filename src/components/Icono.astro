---
/**
 * Iconos de contacto, dibujados a línea para que acompañen a las
 * ilustraciones botánicas de la papelería en lugar de competir con ellas.
 */
interface Props {
  nombre: 'whatsapp' | 'instagram' | 'tiktok' | 'sol' | 'gota' | 'maceta' | 'bolsa';
  class?: string;
}

const { nombre, class: clase = 'h-6 w-6' } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  class={clase}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    nombre === 'whatsapp' && (
      <>
        <path d="M20.5 11.7a8.4 8.4 0 0 1-12.5 7.3l-4.5 1.4 1.4-4.4A8.4 8.4 0 1 1 20.5 11.7Z" />
        <path d="M9.8 8.9c.3 0 .5.2.6.4l.6 1.4c.1.2 0 .4-.1.6l-.6.7a6.6 6.6 0 0 0 2.7 2.7l.7-.6c.2-.2.4-.2.6-.1l1.4.6c.2.1.4.3.4.6 0 .9-.8 1.6-1.7 1.6a7.2 7.2 0 0 1-7.2-7.2c0-.9.7-1.7 1.6-1.7Z" />
      </>
    )
  }

  {
    nombre === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5.2" />
        <circle cx="12" cy="12" r="4.1" />
        <circle cx="17.3" cy="6.7" r="1.15" fill="currentColor" stroke="none" />
      </>
    )
  }

  {
    nombre === 'tiktok' && (
      <path d="M14.2 3.2v10.9a3.4 3.4 0 1 1-2.8-3.3M14.2 3.2a5 5 0 0 0 5 5" />
    )
  }

  {
    nombre === 'sol' && (
      <>
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2.4v2.2M12 19.4v2.2M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.4 12h2.2M19.4 12h2.2M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6" />
      </>
    )
  }

  {
    nombre === 'gota' && (
      <path d="M12 3.4c3.4 4 5.3 6.8 5.3 9.2a5.3 5.3 0 1 1-10.6 0c0-2.4 1.9-5.2 5.3-9.2Z" />
    )
  }

  {
    nombre === 'bolsa' && (
      <>
        <path d="M5.2 7.8h13.6l-1.1 11a2 2 0 0 1-2 1.8H8.3a2 2 0 0 1-2-1.8Z" />
        <path d="M8.8 10V6.6a3.2 3.2 0 0 1 6.4 0V10" />
      </>
    )
  }

  {
    nombre === 'maceta' && (
      <>
        <path d="M4.8 9.6h14.4l-1.3 9.5a2 2 0 0 1-2 1.7H8.1a2 2 0 0 1-2-1.7Z" />
        <path d="M3.6 6.6h16.8v3H3.6z" />
        <path d="M12 6.6c0-2.4 1.7-4.2 4.2-4.2 0 2.4-1.7 4.2-4.2 4.2Z" />
      </>
    )
  }
</svg>
