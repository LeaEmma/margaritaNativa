---
/**
 * Iconos de contacto, dibujados a línea para que acompañen a las
 * ilustraciones botánicas de la papelería en lugar de competir con ellas.
 */
interface Props {
  nombre: 'whatsapp' | 'instagram' | 'tiktok';
  class?: string;
}

const { nombre, class: clase = 'h-6 w-6' } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  class={clase}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    nombre === 'whatsapp' && (
      <>
        <path d="M20.5 11.7a8.4 8.4 0 0 1-12.5 7.3l-4.5 1.4 1.4-4.4A8.4 8.4 0 1 1 20.5 11.7Z" />
        <path d="M9.8 8.9c.3 0 .5.2.6.4l.6 1.4c.1.2 0 .4-.1.6l-.6.7a6.6 6.6 0 0 0 2.7 2.7l.7-.6c.2-.2.4-.2.6-.1l1.4.6c.2.1.4.3.4.6 0 .9-.8 1.6-1.7 1.6a7.2 7.2 0 0 1-7.2-7.2c0-.9.7-1.7 1.6-1.7Z" />
      </>
    )
  }

  {
    nombre === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5.2" />
        <circle cx="12" cy="12" r="4.1" />
        <circle cx="17.3" cy="6.7" r="1.15" fill="currentColor" stroke="none" />
      </>
    )
  }

  {
    nombre === 'tiktok' && (
      <path d="M14.2 3.2v10.9a3.4 3.4 0 1 1-2.8-3.3M14.2 3.2a5 5 0 0 0 5 5" />
    )
  }
</svg>
