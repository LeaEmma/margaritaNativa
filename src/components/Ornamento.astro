---
/**
 * Trébol de tres puntos. Es el ornamento que flanquea "NATIVA" en el logo y
 * que separa bloques en las tarjetas impresas; acá cumple la misma función.
 */
interface Props {
  /** Agrega filetes a los lados, como el divisor de las tarjetas. */
  conFiletes?: boolean;
  /** Versión clara, para usar sobre foto o sobre fondo borravino/oliva. */
  claro?: boolean;
  class?: string;
}

const { conFiletes = false, claro = false, class: clase = '' } = Astro.props;

// Color por prop y no por clase: `fill-*` desde afuera compite en
// especificidad con el `fill-*` del componente y el resultado depende
// del orden en que Tailwind emita las reglas.
const relleno = claro ? 'fill-crema/70' : 'fill-borravino';
const filete = claro ? 'bg-crema/40' : 'bg-oliva/35';
---

{
  conFiletes ? (
    <div class:list={['flex items-center justify-center gap-5', clase]} aria-hidden="true">
      <span class:list={['h-px w-16 sm:w-24', filete]} />
      <svg viewBox="0 0 20 15" class:list={['h-3 w-4 shrink-0', relleno]}>
        <circle cx="10" cy="4.2" r="3.6" />
        <circle cx="5.6" cy="10.8" r="3.6" />
        <circle cx="14.4" cy="10.8" r="3.6" />
      </svg>
      <span class:list={['h-px w-16 sm:w-24', filete]} />
    </div>
  ) : (
    <svg viewBox="0 0 20 15" class:list={['h-3 w-4', relleno, clase]} aria-hidden="true">
      <circle cx="10" cy="4.2" r="3.6" />
      <circle cx="5.6" cy="10.8" r="3.6" />
      <circle cx="14.4" cy="10.8" r="3.6" />
    </svg>
  )
}
