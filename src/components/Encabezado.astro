---
import { Image } from 'astro:assets';
import sello from '../assets/sello-margarita-nativa.png';
import Icono from './Icono.astro';
import { NAVEGACION, SITIO, enlaceContacto } from '../datos/sitio';
---

<header class="sticky top-0 z-50 border-b border-oliva/20 bg-papel/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-5 py-3">
    <a href="#inicio" class="flex shrink-0 items-center gap-3" aria-label={`${SITIO.nombre} — inicio`}>
      <Image src={sello} alt="" width={96} height={96} class="h-12 w-12" loading="eager" />
      <span class="font-display text-lg leading-tight font-semibold tracking-[0.12em] text-oliva uppercase">
        Margarita<br /><span class="text-base">Nativa</span>
      </span>
    </a>

    <nav class="ml-auto hidden lg:block" aria-label="Principal">
      <ul class="flex items-center gap-7">
        {
          NAVEGACION.map((enlace) => (
            <li>
              <a
                href={enlace.href}
                class="versalitas text-oliva transition-colors hover:text-borravino"
              >
                {enlace.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-4 lg:ml-0">
      {
        SITIO.whatsapp && (
          <a
            href={enlaceContacto('¡Hola! Te escribo desde la web.')}
            target="_blank"
            rel="noopener noreferrer"
            class="text-oliva transition-colors hover:text-borravino"
            aria-label="Escribinos por WhatsApp"
          >
            <Icono nombre="whatsapp" />
          </a>
        )
      }

      <a
        href={SITIO.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="text-oliva transition-colors hover:text-borravino"
        aria-label={`Instagram ${SITIO.instagramUsuario}`}
      >
        <Icono nombre="instagram" />
      </a>
    </div>
  </div>

  <nav class="border-t border-oliva/15 lg:hidden" aria-label="Principal (móvil)">
    <ul class="flex gap-6 overflow-x-auto px-5 py-2.5 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {
        NAVEGACION.map((enlace) => (
          <li class="shrink-0">
            <a href={enlace.href} class="versalitas text-oliva">
              {enlace.texto}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
