---
import { Image } from 'astro:assets';
import Icono from './Icono.astro';
import sello from '../assets/sello-margarita-nativa.png';
import { NAVEGACION, SITIO } from '../datos/sitio';

// Sin barra final, para que "/catalogo" y "/catalogo/" se traten igual.
const normalizar = (p: string) => p.replace(/\/+$/, '') || '/';
const ruta = normalizar(Astro.url.pathname);
const esActiva = (enlace: (typeof NAVEGACION)[number]) =>
  'pagina' in enlace && normalizar(enlace.pagina) === ruta;

// El pedido solo existe si hay número adonde mandarlo.
const hayPedido = Boolean(SITIO.whatsapp);
---

<header id="encabezado" class="group sticky top-0 z-50 border-b border-oliva/20 bg-papel/95 backdrop-blur-sm">
  <!-- Arriba de todo no hay logo: en la home el sello grande ya está a la
       vista. Al bajar (data-desplazado) aparece el sello chico para no perder
       la referencia: en celulares reemplaza la palabra "Menú"; en pantallas
       anchas va pegado a la fila de secciones, con su lugar siempre reservado
       para que el menú no se corra al aparecer. -->
  <div class="relative mx-auto flex max-w-6xl items-center justify-between px-4 lg:justify-center lg:px-5">
    <div class="flex items-center gap-1">
    <button
      type="button"
      id="menu-boton"
      aria-expanded="false"
      aria-controls="menu-movil"
      class="versalitas -ml-2 flex items-center gap-2.5 px-2 py-4 text-oliva transition-colors hover:text-borravino lg:hidden"
    >
      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <path data-icono-abrir d="M4 7h16M4 12h16M4 17h16" />
        <path data-icono-cerrar class="hidden" d="M6 6l12 12M18 6L6 18" />
      </svg>
      <span class="group-data-desplazado:hidden">Menú</span>
      <span class="sr-only hidden group-data-desplazado:inline">Menú</span>
    </button>

    <a
      href="/"
      aria-label="Margarita Nativa — inicio"
      class="hidden opacity-0 transition-opacity duration-300 group-data-desplazado:block group-data-desplazado:opacity-100 lg:invisible lg:mr-8 lg:block lg:group-data-desplazado:visible"
    >
      <Image src={sello} alt="" width={96} height={96} class="h-10 w-10" loading="eager" />
    </a>
    </div>

    <nav class="hidden lg:block" aria-label="Principal">
      <ul class="flex items-center gap-8">
        {
          NAVEGACION.map((enlace) => (
            <li>
              <a
                href={enlace.href}
                aria-current={esActiva(enlace) ? 'page' : undefined}
                class:list={[
                  'versalitas block py-4 transition-colors',
                  esActiva(enlace)
                    ? 'text-borravino underline underline-offset-4'
                    : 'text-oliva hover:text-borravino',
                ]}
              >
                {enlace.texto}
              </a>
            </li>
          ))
        }
        {
          hayPedido && (
            <li aria-hidden="true">
              <span class="block h-4 w-px bg-oliva/30" />
            </li>
          )
        }
      </ul>
    </nav>

    {
      hayPedido && (
        <button
          type="button"
          data-abrir-carrito
          class="versalitas -mr-2 flex items-center gap-1.5 px-2 py-4 text-oliva transition-colors hover:text-borravino lg:mr-0 lg:ml-8 lg:px-0"
        >
          <Icono nombre="bolsa" class="h-5 w-5" />
          <span class="sr-only">Abrir tu pedido</span>
          <span data-insignia-carrito hidden class="rounded-full bg-oliva px-1.5 py-0.5 text-xs text-crema">
            0
          </span>
        </button>
      )
    }
  </div>

  <nav id="menu-movil" hidden class="border-t border-oliva/15 lg:hidden" aria-label="Principal (móvil)">
    <ul class="divide-y divide-oliva/15 px-4">
      {
        NAVEGACION.map((enlace) => (
          <li>
            <a
              href={enlace.href}
              aria-current={esActiva(enlace) ? 'page' : undefined}
              class:list={[
                'versalitas block py-4',
                esActiva(enlace) ? 'text-borravino' : 'text-oliva',
              ]}
            >
              {enlace.texto}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // Marca el encabezado cuando la página ya no está arriba de todo.
  const encabezado = document.querySelector<HTMLElement>('#encabezado');
  const marcar = () => encabezado?.toggleAttribute('data-desplazado', window.scrollY > 120);
  marcar();
  window.addEventListener('scroll', marcar, { passive: true });

  const boton = document.querySelector<HTMLButtonElement>('#menu-boton');
  const menu = document.querySelector<HTMLElement>('#menu-movil');

  function abrir(abierto: boolean) {
    if (!boton || !menu) return;
    menu.hidden = !abierto;
    boton.setAttribute('aria-expanded', String(abierto));
    boton.querySelector('[data-icono-abrir]')?.classList.toggle('hidden', abierto);
    boton.querySelector('[data-icono-cerrar]')?.classList.toggle('hidden', !abierto);
  }

  boton?.addEventListener('click', () => abrir(menu?.hidden ?? false));

  // Los enlaces con ancla ("/#eventos") no cambian de página: hay que cerrar a mano.
  menu?.addEventListener('click', (evento) => {
    if ((evento.target as HTMLElement).closest('a')) abrir(false);
  });

  document.addEventListener('keydown', (evento) => {
    if (evento.key === 'Escape' && menu && !menu.hidden) {
      abrir(false);
      boton?.focus();
    }
  });
</script>
