---
import { Image, getImage } from 'astro:assets';
import GaleriaProducto from './GaleriaProducto.astro';
import { aSlug, precio as formatear, type ItemCatalogo } from '../datos/catalogo';
import { miniaturaDe, type Diapositiva } from '../datos/galeria';

/**
 * Fila de precio: el nombre a la izquierda y el precio a la derecha.
 * NOMBRE                ♦ $25.000
 *
 * El nombre y el precio comparten la primera línea y la descripción va debajo,
 * igual que en el impreso. En pantallas angostas el precio va siempre en la
 * línea siguiente: con miniatura y botón de agregar el ancho útil baja a
 * ~180px, y compartiendo línea el nombre se partía y se montaba sobre el
 * precio.
 *
 * La miniatura es opcional: si el producto todavía no tiene foto, la fila se
 * muestra igual, sin hueco. Así se pueden ir sumando fotos de a poco.
 *
 * Si el producto viene en varias variantes (tamaños o variedades), debajo del
 * nombre hay un selector y el precio es el de la elegida (de entrada, la más
 * barata, con "desde" si no valen todas lo mismo). Al pedido va la variante
 * como un producto propio ("Lavanda chica"), así el carrito y el mensaje de
 * WhatsApp no cambian. El enlace a cuidados también sigue a la variante, para
 * las que tienen ficha propia (albahaca, romero, menta).
 *
 * Las macetas pueden tener además una etiqueta ("Autorriego") y colores para
 * elegir: el color cambia la miniatura y se suma al pedido ("Mate N°30 arena").
 */
interface Props {
  item: ItemCatalogo;
  /** Texto chico después del precio, p. ej. "c/u". */
  sufijo?: string;
  foto?: ImageMetadata;
  /** Dado el slug de un producto o de una variante, el enlace a su ficha de
   *  cuidados, si existe. El texto del enlace va sin género: hay plantas
   *  masculinas (jazmín, lilium, pino) y femeninas (lavanda, monstera) en la
   *  misma lista. */
  enlaceCuidados?: (slug: string) => string | undefined;
  /** Muestra el botón de agregar al pedido. */
  agregable?: boolean;
  /** Fotos y videos del producto, que se abren desde la fila sin agrandarla. */
  galeria?: Diapositiva[];
  /** Colores para elegir, cada uno con su foto si la tiene. */
  colores?: { nombre: string; foto?: ImageMetadata }[];
}

const { item, sufijo, foto, enlaceCuidados, agregable = false, galeria = [], colores = [] } = Astro.props;

/** Sin foto propia, la miniatura es la primera pieza de la galería. */
const miniatura = foto ?? miniaturaDe(galeria);

/** La ficha de la variante si tiene una propia; si no, la del producto. */
const cuidadosDe = (slug: string) => enlaceCuidados?.(slug) ?? enlaceCuidados?.(item.slug);

/** Lo que se agrega al pedido: el producto, o su variante más barata. */
const variantes = (item.tamanos ?? []).map((t) => {
  const slug = `${item.slug}-${aSlug(t.nombre)}`;
  // "Chica" → "Lavanda chica", pero las medidas quedan como están: "Mate N°46".
  const variante = /^\p{Lu}\p{Ll}/u.test(t.nombre) ? t.nombre.toLowerCase() : t.nombre;
  return { ...t, slug, nombreCompleto: `${item.nombre} ${variante}`, cuidados: cuidadosDe(slug) };
});
const elegido = variantes[0] ?? {
  slug: item.slug,
  nombreCompleto: item.nombre,
  precio: item.precio,
  cuidados: cuidadosDe(item.slug),
};

/** Medidas y planta sugerida de lo que se muestra de entrada (macetas). */
const elegidoInfo = item.tamanos?.[0] ?? { medidas: item.medidas, ideal: item.ideal };

/** Las miniaturas se generan acá para que el navegador pueda cambiarlas al elegir un color. */
const opcionesColor = await Promise.all(
  colores.map(async (c) => ({
    nombre: c.nombre,
    slug: aSlug(c.nombre),
    foto: c.foto && (await getImage({ src: c.foto, width: 176, height: 176 })).src,
  })),
);
const coloresIniciales = item.tamanos?.[0]?.colores;
/** Con una foto de todos los colores, ninguno arranca elegido: la foto cambia al elegir. */
const colorInicial = item.vistaGeneral ? undefined : opcionesColor.find((c) => coloresIniciales?.includes(c.nombre) ?? true);
const pedido = colorInicial
  ? { slug: `${elegido.slug}-${colorInicial.slug}`, nombre: `${elegido.nombreCompleto} ${colorInicial.nombre.toLowerCase()}` }
  : { slug: elegido.slug, nombre: elegido.nombreCompleto };
---

<div
  class="flex items-center gap-3 py-4 sm:gap-4"
  data-fila
  data-precio-minimo={item.precio}
  data-base-slug={item.slug}
  data-base-nombre={item.nombre}
>
  {
    miniatura && (
      <Image
        src={miniatura}
        alt={item.nombre}
        data-miniatura
        width={176}
        height={176}
        class:list={[
          'h-14 w-14 shrink-0 rounded-lg border border-oliva/20 object-cover sm:h-20 sm:w-20',
          galeria.length > 0 && 'cursor-zoom-in',
        ]}
        loading="lazy"
      />
    )
  }

  <div class="min-w-0 flex-1">
    {/* En celulares el nombre va arriba a todo el ancho y el precio debajo:
        compartiendo línea, los nombres largos se apretaban sobre el precio. */}
    <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4">
      <h3 class="font-display text-lg font-semibold tracking-wide text-borravino uppercase sm:min-w-0 sm:flex-1 sm:text-xl">
        {item.nombre}
        {
          item.etiqueta && (
            <span class="ml-1.5 inline-block rounded-full bg-oliva px-2.5 py-0.5 align-middle text-[0.65rem] font-medium tracking-[0.14em] text-crema">
              {item.etiqueta}
            </span>
          )
        }
      </h3>

      {/* Precio a la derecha: así los de todas las filas quedan alineados. */}
      <p class="flex shrink-0 items-baseline gap-2">
        <svg viewBox="0 0 10 14" class="h-3 w-2 self-center fill-oliva-medio" aria-hidden="true">
          <path d="M5 0 9.5 7 5 14 .5 7Z" />
        </svg>
        {item.desde && <span data-desde class="text-sm text-oliva">desde</span>}
        <span data-precio class="font-display text-xl font-semibold text-oliva sm:text-3xl">
          {formatear(item.precio)}
        </span>
        {sufijo && <span class="text-sm text-oliva">{sufijo}</span>}
      </p>
    </div>

    {item.detalle && <p class="mt-1.5 text-balance text-oliva">{item.detalle}</p>}

    {/* Medidas y planta sugerida (macetas): siguen a la variante elegida. */}
    {
      (elegidoInfo.medidas || elegidoInfo.ideal) && (
        <p class="mt-1 text-sm text-oliva/85">
          <span data-medidas>{elegidoInfo.medidas}</span>
          <span data-ideal class="block">{elegidoInfo.ideal}</span>
        </p>
      )
    }

    {
      variantes.length > 0 && (
        <fieldset class="mt-2.5 flex flex-wrap items-center gap-2">
          <legend class="sr-only">Opciones de {item.nombre}</legend>
          {variantes.map((v, i) => (
            <label class="cursor-pointer">
              <input
                type="radio"
                name={`variante-${item.slug}`}
                value={v.slug}
                checked={i === 0}
                data-variante
                data-slug={v.slug}
                data-nombre={v.nombreCompleto}
                data-precio={v.precio}
                data-ficha={v.cuidados}
                data-medidas={v.medidas}
                data-ideal={v.ideal}
                data-colores={v.colores?.join('|')}
                class="peer sr-only"
              />
              <span class="block rounded-full border border-oliva/35 px-3.5 py-1 text-xs font-medium tracking-[0.18em] text-oliva uppercase transition-colors peer-checked:border-borravino peer-checked:bg-borravino peer-checked:text-crema peer-focus-visible:ring-2 peer-focus-visible:ring-borravino/40 hover:border-borravino hover:text-borravino peer-checked:hover:text-crema">
                {v.nombre}
              </span>
            </label>
          ))}
        </fieldset>
      )
    }

    {
      opcionesColor.length > 0 && (
        <fieldset class="mt-2 flex flex-wrap items-center gap-2">
          <legend class="sr-only">Color de {item.nombre}</legend>
          <span aria-hidden="true" class="text-sm text-oliva">Color</span>
          {opcionesColor.map((c) => (
            <label class="cursor-pointer" hidden={!(coloresIniciales?.includes(c.nombre) ?? true)}>
              <input
                type="radio"
                name={`color-${item.slug}`}
                value={c.slug}
                checked={c === colorInicial}
                data-color={c.nombre}
                data-foto={c.foto}
                class="peer sr-only"
              />
              <span class="block rounded-full border border-oliva/35 px-3.5 py-1 text-xs font-medium tracking-[0.18em] text-oliva uppercase transition-colors peer-checked:border-oliva peer-checked:bg-oliva peer-checked:text-crema peer-focus-visible:ring-2 peer-focus-visible:ring-oliva/40 hover:border-oliva peer-checked:hover:text-crema">
                {c.nombre}
              </span>
            </label>
          ))}
        </fieldset>
      )
    }

    {
      (elegido.cuidados || galeria.length > 0) && (
        <div class="mt-1.5 flex flex-wrap gap-x-5 gap-y-1">
          {elegido.cuidados && (
            <a
              href={elegido.cuidados}
              data-cuidados
              class="inline-block text-sm text-borravino underline underline-offset-4 transition-colors hover:text-borravino-medio"
            >
              Ver cuidados →
            </a>
          )}
          <GaleriaProducto nombre={item.nombre} slug={item.slug} diapositivas={galeria} />
        </div>
      )
    }
  </div>

  {
    agregable && (
      <button
        type="button"
        data-agregar
        data-slug={pedido.slug}
        data-nombre={pedido.nombre}
        data-precio={elegido.precio}
        aria-label={`Agregar ${pedido.nombre} al pedido`}
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-borravino/40 text-xl leading-none text-borravino transition-colors hover:border-borravino hover:bg-borravino hover:text-crema"
      >
        +
      </button>
    )
  }
</div>

<script>
  /**
   * Al elegir una variante, la fila pasa a mostrar su precio, el enlace de
   * cuidados apunta a su ficha y el botón de agregar pasa a cargarla. "desde"
   * queda solo mientras la elegida es la más barata. Sin JavaScript la fila
   * muestra y agrega la primera. El color cambia la miniatura y se suma a lo
   * que se agrega; si la medida elegida no viene en ese color, pasa al primero
   * que sí tenga.
   */
  const plata = new Intl.NumberFormat('es-AR', {
    style: 'currency',
    currency: 'ARS',
    maximumFractionDigits: 0,
  });
  const precio = (v: number) => plata.format(v).replace(/\s/g, '');

  function aplicar(radio: HTMLInputElement) {
    const fila = radio.closest<HTMLElement>('[data-fila]');
    if (!fila) return;
    const valor = Number(radio.dataset.precio);

    fila.querySelector<HTMLElement>('[data-precio]')!.textContent = precio(valor);
    const desde = fila.querySelector<HTMLElement>('[data-desde]');
    if (desde) desde.hidden = valor !== Number(fila.dataset.precioMinimo);

    const cuidados = fila.querySelector<HTMLAnchorElement>('a[data-cuidados]');
    if (cuidados && radio.dataset.ficha) cuidados.href = radio.dataset.ficha;

    const boton = fila.querySelector<HTMLButtonElement>('[data-agregar]');
    if (boton) boton.dataset.precio = radio.dataset.precio;

    const medidas = fila.querySelector<HTMLElement>('[data-medidas]');
    if (medidas) medidas.textContent = radio.dataset.medidas ?? '';
    const ideal = fila.querySelector<HTMLElement>('[data-ideal]');
    if (ideal) ideal.textContent = radio.dataset.ideal ?? '';

    filtrarColores(fila, radio.dataset.colores);
    actualizarPedido(fila);
  }

  /** Deja a la vista los colores de la medida elegida. */
  function filtrarColores(fila: HTMLElement, lista: string | undefined) {
    const permitidos = lista?.split('|');
    const radios = [...fila.querySelectorAll<HTMLInputElement>('input[data-color]')];
    for (const radio of radios) {
      const etiqueta = radio.closest('label');
      if (etiqueta) etiqueta.hidden = permitidos ? !permitidos.includes(radio.dataset.color!) : false;
    }
    if (radios.find((r) => r.checked)?.closest('label')?.hidden) {
      const primero = radios.find((r) => !r.closest('label')?.hidden);
      if (primero) {
        primero.checked = true;
        mostrarColor(primero);
      }
    }
  }

  function mostrarColor(radio: HTMLInputElement) {
    const imagen = radio.closest('[data-fila]')?.querySelector<HTMLImageElement>('[data-miniatura]');
    if (imagen && radio.dataset.foto) {
      imagen.removeAttribute('srcset');
      imagen.src = radio.dataset.foto;
    }
  }

  /** Lo que carga el botón: el producto o su medida, más el color si tiene. */
  function actualizarPedido(fila: HTMLElement) {
    const boton = fila.querySelector<HTMLButtonElement>('[data-agregar]');
    if (!boton) return;
    const variante = fila.querySelector<HTMLInputElement>('input[data-variante]:checked');
    const color = fila.querySelector<HTMLInputElement>('input[data-color]:checked');
    const slug = variante?.dataset.slug ?? fila.dataset.baseSlug;
    const nombre = variante?.dataset.nombre ?? fila.dataset.baseNombre;
    boton.dataset.slug = color ? `${slug}-${color.value}` : slug;
    boton.dataset.nombre = color ? `${nombre} ${color.dataset.color!.toLowerCase()}` : nombre;
    boton.setAttribute('aria-label', `Agregar ${boton.dataset.nombre} al pedido`);
  }

  document.addEventListener('change', (evento) => {
    const radio = evento.target;
    if (!(radio instanceof HTMLInputElement)) return;
    if (radio.matches('input[data-variante]')) aplicar(radio);
    if (radio.matches('input[data-color]')) {
      mostrarColor(radio);
      actualizarPedido(radio.closest<HTMLElement>('[data-fila]')!);
    }
  });

  // Al volver con "atrás", el navegador restaura los radios pero no el texto.
  window.addEventListener('pageshow', () => {
    for (const radio of document.querySelectorAll<HTMLInputElement>('input[data-variante]:checked')) aplicar(radio);
    for (const radio of document.querySelectorAll<HTMLInputElement>('input[data-color]:checked')) {
      mostrarColor(radio);
      actualizarPedido(radio.closest<HTMLElement>('[data-fila]')!);
    }
  });
</script>
