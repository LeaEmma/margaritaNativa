---
import { Image } from 'astro:assets';
import GaleriaProducto from './GaleriaProducto.astro';
import { aSlug, precio as formatear, type ItemCatalogo } from '../datos/catalogo';
import { miniaturaDe, type Diapositiva } from '../datos/galeria';

/**
 * Fila de precio: el nombre a la izquierda y el precio a la derecha.
 * NOMBRE                ♦ $25.000
 *
 * El nombre y el precio comparten la primera línea y la descripción va debajo,
 * igual que en el impreso. En pantallas angostas el precio va siempre en la
 * línea siguiente: con miniatura y botón de agregar el ancho útil baja a
 * ~180px, y compartiendo línea el nombre se partía y se montaba sobre el
 * precio.
 *
 * La miniatura es opcional: si el producto todavía no tiene foto, la fila se
 * muestra igual, sin hueco. Así se pueden ir sumando fotos de a poco.
 *
 * Si el producto viene en varias variantes (tamaños o variedades), debajo del
 * nombre hay un selector y el precio es el de la elegida (de entrada, la más
 * barata, con "desde" si no valen todas lo mismo). Al pedido va la variante
 * como un producto propio ("Lavanda chica"), así el carrito y el mensaje de
 * WhatsApp no cambian. El enlace a cuidados también sigue a la variante, para
 * las que tienen ficha propia (albahaca, romero, menta).
 */
interface Props {
  item: ItemCatalogo;
  /** Texto chico después del precio, p. ej. "c/u". */
  sufijo?: string;
  foto?: ImageMetadata;
  /** Dado el slug de un producto o de una variante, el enlace a su ficha de
   *  cuidados, si existe. El texto del enlace va sin género: hay plantas
   *  masculinas (jazmín, lilium, pino) y femeninas (lavanda, monstera) en la
   *  misma lista. */
  enlaceCuidados?: (slug: string) => string | undefined;
  /** Muestra el botón de agregar al pedido. */
  agregable?: boolean;
  /** Fotos y videos del producto, que se abren desde la fila sin agrandarla. */
  galeria?: Diapositiva[];
}

const { item, sufijo, foto, enlaceCuidados, agregable = false, galeria = [] } = Astro.props;

/** Sin foto propia, la miniatura es la primera pieza de la galería. */
const miniatura = foto ?? miniaturaDe(galeria);

/** La ficha de la variante si tiene una propia; si no, la del producto. */
const cuidadosDe = (slug: string) => enlaceCuidados?.(slug) ?? enlaceCuidados?.(item.slug);

/** Lo que se agrega al pedido: el producto, o su variante más barata. */
const variantes = (item.tamanos ?? []).map((t) => {
  const slug = `${item.slug}-${aSlug(t.nombre)}`;
  return { ...t, slug, nombreCompleto: `${item.nombre} ${t.nombre.toLowerCase()}`, cuidados: cuidadosDe(slug) };
});
const elegido = variantes[0] ?? {
  slug: item.slug,
  nombreCompleto: item.nombre,
  precio: item.precio,
  cuidados: cuidadosDe(item.slug),
};
---

<div class="flex items-center gap-3 py-4 sm:gap-4" data-fila data-precio-minimo={item.precio}>
  {
    miniatura && (
      <Image
        src={miniatura}
        alt={item.nombre}
        width={176}
        height={176}
        class="h-14 w-14 shrink-0 rounded-lg border border-oliva/20 object-cover sm:h-20 sm:w-20"
        loading="lazy"
      />
    )
  }

  <div class="min-w-0 flex-1">
    {/* En celulares el nombre va arriba a todo el ancho y el precio debajo:
        compartiendo línea, los nombres largos se apretaban sobre el precio. */}
    <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4">
      <h3 class="font-display text-lg font-semibold tracking-wide text-borravino uppercase sm:min-w-0 sm:flex-1 sm:text-xl">
        {item.nombre}
      </h3>

      {/* Precio a la derecha: así los de todas las filas quedan alineados. */}
      <p class="flex shrink-0 items-baseline gap-2">
        <svg viewBox="0 0 10 14" class="h-3 w-2 self-center fill-oliva-medio" aria-hidden="true">
          <path d="M5 0 9.5 7 5 14 .5 7Z" />
        </svg>
        {item.desde && <span data-desde class="text-sm text-oliva">desde</span>}
        <span data-precio class="font-display text-xl font-semibold text-oliva sm:text-3xl">
          {formatear(item.precio)}
        </span>
        {sufijo && <span class="text-sm text-oliva">{sufijo}</span>}
      </p>
    </div>

    {item.detalle && <p class="mt-1.5 text-balance text-oliva">{item.detalle}</p>}

    {
      variantes.length > 0 && (
        <fieldset class="mt-2.5 flex flex-wrap items-center gap-2">
          <legend class="sr-only">Opciones de {item.nombre}</legend>
          {variantes.map((v, i) => (
            <label class="cursor-pointer">
              <input
                type="radio"
                name={`variante-${item.slug}`}
                value={v.slug}
                checked={i === 0}
                data-variante
                data-slug={v.slug}
                data-nombre={v.nombreCompleto}
                data-precio={v.precio}
                data-ficha={v.cuidados}
                class="peer sr-only"
              />
              <span class="block rounded-full border border-oliva/35 px-3.5 py-1 text-xs font-medium tracking-[0.18em] text-oliva uppercase transition-colors peer-checked:border-borravino peer-checked:bg-borravino peer-checked:text-crema peer-focus-visible:ring-2 peer-focus-visible:ring-borravino/40 hover:border-borravino hover:text-borravino peer-checked:hover:text-crema">
                {v.nombre}
              </span>
            </label>
          ))}
        </fieldset>
      )
    }

    {
      (elegido.cuidados || galeria.length > 0) && (
        <div class="mt-1.5 flex flex-wrap gap-x-5 gap-y-1">
          {elegido.cuidados && (
            <a
              href={elegido.cuidados}
              data-cuidados
              class="inline-block text-sm text-borravino underline underline-offset-4 transition-colors hover:text-borravino-medio"
            >
              Ver cuidados →
            </a>
          )}
          <GaleriaProducto nombre={item.nombre} slug={item.slug} diapositivas={galeria} />
        </div>
      )
    }
  </div>

  {
    agregable && (
      <button
        type="button"
        data-agregar
        data-slug={elegido.slug}
        data-nombre={elegido.nombreCompleto}
        data-precio={elegido.precio}
        aria-label={`Agregar ${elegido.nombreCompleto} al pedido`}
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-borravino/40 text-xl leading-none text-borravino transition-colors hover:border-borravino hover:bg-borravino hover:text-crema"
      >
        +
      </button>
    )
  }
</div>

<script>
  /**
   * Al elegir una variante, la fila pasa a mostrar su precio, el enlace de
   * cuidados apunta a su ficha y el botón de agregar pasa a cargarla. "desde"
   * queda solo mientras la elegida es la más barata. Sin JavaScript la fila
   * muestra y agrega la primera.
   */
  const plata = new Intl.NumberFormat('es-AR', {
    style: 'currency',
    currency: 'ARS',
    maximumFractionDigits: 0,
  });
  const precio = (v: number) => plata.format(v).replace(/\s/g, '');

  function aplicar(radio: HTMLInputElement) {
    const fila = radio.closest<HTMLElement>('[data-fila]');
    if (!fila) return;
    const valor = Number(radio.dataset.precio);

    fila.querySelector<HTMLElement>('[data-precio]')!.textContent = precio(valor);
    const desde = fila.querySelector<HTMLElement>('[data-desde]');
    if (desde) desde.hidden = valor !== Number(fila.dataset.precioMinimo);

    const cuidados = fila.querySelector<HTMLAnchorElement>('a[data-cuidados]');
    if (cuidados && radio.dataset.ficha) cuidados.href = radio.dataset.ficha;

    const boton = fila.querySelector<HTMLButtonElement>('[data-agregar]');
    if (boton) {
      boton.dataset.slug = radio.dataset.slug;
      boton.dataset.nombre = radio.dataset.nombre;
      boton.dataset.precio = radio.dataset.precio;
      boton.setAttribute('aria-label', `Agregar ${radio.dataset.nombre} al pedido`);
    }
  }

  document.addEventListener('change', (evento) => {
    const radio = evento.target;
    if (radio instanceof HTMLInputElement && radio.matches('input[data-variante]')) aplicar(radio);
  });

  // Al volver con "atrás", el navegador restaura los radios pero no el texto.
  window.addEventListener('pageshow', () => {
    for (const radio of document.querySelectorAll<HTMLInputElement>('input[data-variante]:checked')) aplicar(radio);
  });
</script>
