---
/**
 * Hoja de papel con filete oliva y esquinas redondeadas: el contenedor de
 * todas las tarjetas impresas de la marca.
 */
interface Props {
  class?: string;
}

const { class: clase = '' } = Astro.props;
---

<div
  class:list={[
    'rounded-xl border border-oliva/30 bg-papel-claro p-4 shadow-[0_1px_2px_rgba(63,68,32,0.05)] sm:p-9',
    clase,
  ]}
>
  <slot />
</div>
