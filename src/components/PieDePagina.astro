---
import { Image } from 'astro:assets';
import sello from '../assets/sello-margarita-nativa.png';
import Ornamento from './Ornamento.astro';
import Icono from './Icono.astro';
import { NAVEGACION, SITIO, enlaceContacto } from '../datos/sitio';

const anio = 2026;
---

<footer class="mt-24 border-t border-oliva/20 bg-papel-claro">
  <div class="mx-auto max-w-6xl px-5 py-16 text-center">
    <Image src={sello} alt={SITIO.nombre} width={160} height={160} class="mx-auto h-24 w-24" />

    <p class="epigrafe mt-6">{SITIO.lema}</p>

    <Ornamento conFiletes class="mt-6" />

    <nav class="mt-8" aria-label="Pie de página">
      <ul class="flex flex-wrap items-center justify-center gap-x-7 gap-y-3">
        {
          NAVEGACION.map((enlace) => (
            <li>
              <a href={enlace.href} class="versalitas block py-2 text-oliva transition-colors hover:text-borravino">
                {enlace.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
      {
        SITIO.whatsapp && (
          <a
            href={enlaceContacto('¡Hola! Te escribo desde la web.')}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 py-1.5 text-borravino transition-colors hover:text-borravino-medio"
          >
            <Icono nombre="whatsapp" class="h-5 w-5" />
            WhatsApp
          </a>
        )
      }
      <a
        href={SITIO.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 py-1.5 text-borravino transition-colors hover:text-borravino-medio"
      >
        <Icono nombre="instagram" class="h-5 w-5" />
        {SITIO.instagramUsuario}
      </a>
      <a
        href={SITIO.tiktok}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 py-1.5 text-borravino transition-colors hover:text-borravino-medio"
      >
        <Icono nombre="tiktok" class="h-5 w-5" />
        {SITIO.tiktokUsuario}
      </a>
      <a href={`mailto:${SITIO.email}`} class="block py-1.5 text-borravino transition-colors hover:text-borravino-medio">
        {SITIO.email}
      </a>
      <a
        href={SITIO.resenaGoogle}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 py-1.5 text-borravino transition-colors hover:text-borravino-medio"
      >
        <Icono nombre="estrella" class="h-5 w-5" />
        Opinar en Google
      </a>
    </div>

    <p class="mt-10 text-sm text-oliva">
      © {anio} {SITIO.nombre}. Las fotos son ilustrativas: las flores varían según la estación.
    </p>
  </div>
</footer>
