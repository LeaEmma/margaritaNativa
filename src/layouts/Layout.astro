---
import '../styles/global.css';
import Encabezado from '../components/Encabezado.astro';
import PieDePagina from '../components/PieDePagina.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import Carrito from '../components/Carrito.astro';
import { SITIO } from '../datos/sitio';

interface Props {
  titulo?: string;
  descripcion?: string;
  /** Mensaje prearmado del botón flotante de WhatsApp para esta página. */
  mensajeWhatsApp?: string;
}

const { titulo, descripcion = SITIO.descripcion, mensajeWhatsApp } = Astro.props;

const tituloCompleto = titulo
  ? `${titulo} — ${SITIO.nombre}`
  : `${SITIO.nombre} — ${SITIO.lema} en ${SITIO.zonaCorta}`;
const canonica = new URL(Astro.url.pathname, Astro.site ?? 'https://margaritanativa.com.ar');
// La imagen que muestran WhatsApp y las redes al compartir un link. Va con
// dirección absoluta: varias plataformas no resuelven rutas relativas.
const imagenCompartir = new URL('/og-margarita-nativa.jpg', canonica);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" href="/favicon-512.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#500000" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={SITIO.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenCompartir} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITIO.nombre}: ramos de flores de estación`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imagenCompartir} />

    <!-- Para que cada página sume lo suyo, p. ej. datos estructurados. -->
    <slot name="head" />
  </head>

  <body class="antialiased">
    <a
      href="#contenido"
      class="versalitas sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[60] focus:rounded-full focus:bg-borravino focus:px-5 focus:py-3 focus:text-crema"
    >
      Saltar al contenido
    </a>

    <Encabezado />
    <main id="contenido">
      <slot />
    </main>
    <PieDePagina />
    <BotonWhatsApp mensaje={mensajeWhatsApp} />
    <Carrito />
  </body>
</html>
