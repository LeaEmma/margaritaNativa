---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Margarita Nativa">
  <main class="mx-auto flex min-h-screen max-w-3xl flex-col items-center justify-center px-6 text-center">
    <img src="/favicon.svg" alt="Margarita Nativa" class="h-28 w-28" />

    <h1 class="font-display mt-8 text-5xl tracking-[0.18em] text-oliva uppercase">
      Margarita Nativa
    </h1>
    <div class="mt-4 h-px w-24 bg-borravino/40"></div>

    <p class="mt-6 text-lg text-oliva-oscuro/80">
      El sitio está en construcción.
    </p>

    <p class="mt-10 text-xs tracking-widest text-oliva/60 uppercase">
      Próximamente
    </p>
  </main>
</Layout>
