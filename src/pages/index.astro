---
import { Image } from 'astro:assets';

import Layout from '../layouts/Layout.astro';
import TituloSeccion from '../components/TituloSeccion.astro';
import Boton from '../components/Boton.astro';
import Ornamento from '../components/Ornamento.astro';
import Icono from '../components/Icono.astro';

import { SUSCRIPCION, EXHIBIDOR, CUIDADOS, precio } from '../datos/catalogo';
import { SITIO, enlaceContacto } from '../datos/sitio';

import sello from '../assets/sello-margarita-nativa.png';
import orquideaFucsia from '../assets/fotos/orquidea-fucsia.jpg';
import orquideaBlanca from '../assets/fotos/orquidea-blanca.jpg';
import ramosVariedad from '../assets/fotos/ramos-variedad.jpg';
import localExhibidor from '../assets/fotos/local-exhibidor.jpg';
import liriosArreglo from '../assets/fotos/lirios-arreglo.jpg';

/*
 * Orden de secciones pensado para que no haya dos fondos oscuros seguidos:
 * hero (borravino) · cómo funciona (papel claro) · suscripción (tinta) ·
 * eventos (papel) · preguntas (papel claro) · contacto (borravino).
 */

const PASOS = [
  { n: '01', titulo: 'Escribinos', texto: 'Contanos para quién es y para qué ocasión. Te ayudamos a elegir.' },
  { n: '02', titulo: 'Lo armamos', texto: 'Preparamos tu ramo a mano, con flores frescas de estación.' },
  { n: '03', titulo: 'Lo entregamos', texto: 'Coordinamos día y horario. Llega envuelto y listo para regalar.' },
];

/** Las tres tarjetas del exhibidor, con el mismo armado que las de suscripción. */
const PLANES_EXHIBIDOR = [
  { nombre: 'Exhibidor', detalle: 'Para tu local', valor: 'Sin costo', unidad: 'te lo dejamos', nota: 'Blanco o negro' },
  {
    nombre: 'Ramos',
    detalle: 'Flores de estación',
    valor: precio(EXHIBIDOR.ramos.precio),
    unidad: 'desde, por ramo',
    nota: 'Consultá la variedad',
  },
  {
    nombre: 'Servicio',
    detalle: 'Reposición de ramos',
    valor: 'Mensual',
    unidad: 'se cobra por mes',
    nota: 'Según tu demanda',
  },
];

/**
 * Ficha de negocio para buscadores (schema.org). Es lo que le dice a Google
 * que esto es una florería y dónde trabaja. Falta la dirección con calle:
 * se agrega en `address` cuando se decida cuál publicar.
 */
const FICHA_NEGOCIO = {
  '@context': 'https://schema.org',
  '@type': 'Florist',
  name: SITIO.nombre,
  description: SITIO.descripcion,
  url: Astro.site?.href ?? 'https://margaritanativa.com.ar/',
  logo: new URL('/favicon-512.png', Astro.site ?? 'https://margaritanativa.com.ar').href,
  image: new URL('/og-margarita-nativa.jpg', Astro.site ?? 'https://margaritanativa.com.ar').href,
  telephone: `+${SITIO.whatsapp}`,
  email: SITIO.email,
  sameAs: [SITIO.instagram, SITIO.tiktok, SITIO.perfilGoogle],
  hasMap: SITIO.perfilGoogle,
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITIO.zona,
    addressRegion: SITIO.zonaCorta,
    addressCountry: 'AR',
  },
  areaServed: { '@type': 'City', name: SITIO.zona },
  priceRange: '$$',
};

const PREGUNTAS = [
  {
    p: '¿Qué flores vienen en cada ramo?',
    r: 'Las de estación. Trabajamos con lo que da la temporada, así que el ramo cambia a lo largo del año. Por eso cada entrega es distinta y única.',
  },
  {
    p: '¿Puedo pedir flores o colores puntuales?',
    r: 'Sí. El ramo personalizado se arma a medida: nos decís la paleta, la flor o la ocasión y lo preparamos. Arranca en ' + precio(50000) + '.',
  },
  {
    p: '¿Cómo cuido las flores para que duren?',
    r: 'Cambiá el agua cada dos días, mantené limpio el recipiente y ubicá el ramo lejos del sol directo y de fuentes de calor.',
  },
  {
    p: 'Tengo un local, ¿cómo funciona el exhibidor?',
    r: 'Te dejamos un exhibidor sin costo, en blanco o negro, con ramos de estación desde ' + precio(EXHIBIDOR.ramos.precio) + '. El servicio se cobra por mes y vamos reponiendo los ramos según lo que necesite tu negocio. Al terminar el servicio retiramos el exhibidor.',
  },
];
---

<Layout>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(FICHA_NEGOCIO)} />
  {/* ---------------------------------------------------------------- Hero */}
  <section id="inicio" class="relative isolate flex min-h-[78vh] items-center justify-center overflow-hidden">
    <Image
      src={orquideaFucsia}
      alt="Orquídeas fucsias y naranjas en flor"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 -z-10 bg-borravino/75"></div>

    {/* El relleno crece solo en pantallas altas: con el resumen de rubros, a
        py-24 los botones caían debajo del pliegue en ventanas de ~650px. */}
    <div class="mx-auto max-w-3xl px-5 py-16 text-center [@media(min-height:800px)]:py-24">
      <Image src={sello} alt={SITIO.nombre} width={320} height={320} class="mx-auto h-32 w-32 sm:h-40 sm:w-40" loading="eager" />

      <h1 class="font-display mt-8 text-4xl leading-[1.15] font-semibold text-balance text-crema sm:text-6xl">
        Ramos de flores &amp; plantas
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-xl text-balance text-crema">
        Flores y plantas que transforman espacios y acompañan momentos especiales.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <Boton href="/catalogo" variante="claro">Ver el catálogo</Boton>
        <Boton href="#suscripcion" variante="contorno" class="border-crema/50 text-crema hover:border-crema hover:bg-crema/10">
          Suscribirme
        </Boton>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------- Cómo funciona */}
  <section class="bg-papel-claro py-20">
    <div class="mx-auto max-w-5xl px-5">
      <TituloSeccion titulo="Ramos a tu medida" epigrafe="Cómo funciona" />

      <div class="mt-14 grid gap-8 sm:grid-cols-3">
        {
          PASOS.map((paso) => (
            <div class="text-center">
              <p class="font-display text-5xl font-semibold text-borravino/50">{paso.n}</p>
              <h3 class="font-display mt-3 text-xl font-semibold tracking-wide text-borravino uppercase">
                {paso.titulo}
              </h3>
              <p class="mt-3 text-balance text-oliva">{paso.texto}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-12 text-center">
        <Boton href="/catalogo#ramos" variante="contorno">Ver ramos</Boton>
      </div>
    </div>
  </section>

  {/* ------------------------------------------- Suscripción + exhibidor */}
  <section id="suscripcion" class="relative isolate overflow-hidden py-24">
    <Image
      src={ramosVariedad}
      alt=""
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      widths={[640, 1400]}
      sizes="100vw"
    />
    <div class="absolute inset-0 -z-10 bg-tinta/90"></div>

    <div class="mx-auto max-w-4xl px-5">
      <TituloSeccion titulo="Suscripción" epigrafe="Flores frescas, siempre" claro />

      <p class="mx-auto mt-8 max-w-2xl text-center text-lg text-balance text-crema">
        Elegís cada cuánto querés recibir tu ramo y nos ocupamos del resto.
        Todos los ramos son de flores de estación.
      </p>

      <div class="mt-12 grid gap-5 sm:grid-cols-3">
        {
          SUSCRIPCION.map((plan) => (
            <div class="rounded-xl border border-crema/25 bg-crema/10 p-7 text-center backdrop-blur-[2px]">
              <h3 class="font-display text-xl font-semibold tracking-[0.1em] text-crema uppercase">
                {plan.nombre}
              </h3>
              <p class="mt-2 text-sm text-crema">{plan.detalle}</p>
              <Ornamento claro class="mx-auto mt-5" />
              <p class="font-display mt-5 text-3xl font-semibold text-crema">{precio(plan.precio)}</p>
              <p class="mt-1 text-sm text-crema">por ramo</p>
              <p class="mt-4 rounded-full border border-crema/25 py-1.5 text-sm text-crema">
                {precio(plan.precioMensual)} al mes
              </p>
            </div>
          ))
        }
      </div>

      <div class="mt-10 text-center">
        <Boton href={enlaceContacto('¡Hola! Me interesa la suscripción de ramos.')} variante="claro" class="gap-2.5">
          <Icono nombre="whatsapp" class="h-5 w-5" />
          Quiero suscribirme
        </Boton>
        <p class="mt-5 text-crema">
          ¿Preferís algo a medida? Consultanos por opciones y ramos personalizados.
        </p>
      </div>

      {/* ------------------------- Exhibidor: la misma suscripción, para locales */}
      <div id="exhibidor" class="mt-20 scroll-mt-32">
        <TituloSeccion titulo="Suscripción con exhibidor" epigrafe="Para locales y comercios" claro />

        <p class="mx-auto mt-8 max-w-2xl text-center text-lg text-balance text-crema">
          La misma idea, para tu negocio: te dejamos un exhibidor con ramos de estación
          y nos ocupamos de reponerlos.
        </p>

        <div class="mt-12 grid gap-5 sm:grid-cols-3">
          {
            PLANES_EXHIBIDOR.map((plan) => (
              <div class="rounded-xl border border-crema/25 bg-crema/10 p-7 text-center backdrop-blur-[2px]">
                <h3 class="font-display text-xl font-semibold tracking-[0.1em] text-crema uppercase">
                  {plan.nombre}
                </h3>
                <p class="mt-2 text-sm text-crema">{plan.detalle}</p>
                <Ornamento claro class="mx-auto mt-5" />
                <p class="font-display mt-5 text-3xl font-semibold text-crema">{plan.valor}</p>
                <p class="mt-1 text-sm text-crema">{plan.unidad}</p>
                <p class="mt-4 rounded-full border border-crema/25 py-1.5 text-sm text-crema">{plan.nota}</p>
              </div>
            ))
          }
        </div>

        <div class="mt-10 text-center">
          <p class="text-crema">Al finalizar el servicio retiramos el exhibidor.</p>
          <Boton
            href={enlaceContacto('¡Hola! Tengo un local y quiero consultar por el exhibidor.')}
            variante="claro"
            class="mt-6 gap-2.5"
          >
            <Icono nombre="whatsapp" class="h-5 w-5" />
            Consultar por exhibidor
          </Boton>
        </div>
      </div>

      {/* ---------------------- Condiciones comunes a suscripción y exhibidor */}
      <div class="mx-auto mt-12 max-w-2xl rounded-xl border border-crema/20 p-7">
        <h3 class="versalitas text-center text-crema">Mantenimiento y cuidado</h3>
        <ul class="mt-5 space-y-3">
          {
            CUIDADOS.map((texto) => (
              <li class="flex gap-3 text-crema">
                <svg viewBox="0 0 10 14" class="mt-2 h-3 w-2 shrink-0 fill-crema/60" aria-hidden="true">
                  <path d="M5 0 9.5 7 5 14 .5 7Z" />
                </svg>
                <span>{texto}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------- Eventos */}
  <section id="eventos" class="mx-auto max-w-6xl scroll-mt-32 px-5 py-20">
    <TituloSeccion titulo="Eventos" epigrafe="Ambientación floral" />

    <div class="mt-14 grid items-center gap-10 lg:grid-cols-2">
      <div>
        <p class="text-lg text-balance text-oliva">
          Ambientamos cumpleaños, fiestas y celebraciones con flores de estación.
          Trabajamos sobre la paleta y el espacio que tengas, y armamos todo en el lugar.
        </p>
        <p class="mt-5 text-lg text-balance text-oliva">
          También preparamos la barra de flores: tus invitados se arman su propio ramo
          y se lo llevan de recuerdo.
        </p>
        <Boton
          href={enlaceContacto('¡Hola! Quiero consultar por ambientación para un evento.')}
          variante="contorno"
          class="mt-8 gap-2.5"
        >
          <Icono nombre="whatsapp" class="h-5 w-5" />
          Pedir presupuesto
        </Boton>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <figure class="overflow-hidden rounded-xl border border-oliva/25">
          <Image src={liriosArreglo} alt="Arreglo con lirios" class="h-full w-full object-cover" widths={[300, 600]} sizes="(min-width: 1024px) 18rem, 45vw" />
        </figure>
        <figure class="overflow-hidden rounded-xl border border-oliva/25">
          <Image src={orquideaBlanca} alt="Orquídea blanca" class="h-full w-full object-cover" widths={[300, 600]} sizes="(min-width: 1024px) 18rem, 45vw" />
        </figure>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------- Preguntas */}
  <section class="bg-papel-claro py-20">
    <div class="mx-auto max-w-3xl px-5">
      <TituloSeccion titulo="Preguntas" epigrafe="Lo que más nos consultan" />

      <div class="mt-12 divide-y divide-oliva/20 border-y border-oliva/20">
        {
          PREGUNTAS.map((item) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-medium text-borravino [&::-webkit-details-marker]:hidden">
                {item.p}
                <svg
                  viewBox="0 0 20 20"
                  class="h-5 w-5 shrink-0 fill-oliva transition-transform duration-300 group-open:rotate-45"
                  aria-hidden="true"
                >
                  <path d="M9 3h2v14H9z" />
                  <path d="M3 9h14v2H3z" />
                </svg>
              </summary>
              <p class="mt-3 pr-9 text-oliva">{item.r}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {/* ----------------------------------------------------------- Contacto */}
  <section id="contacto" class="relative isolate scroll-mt-32 overflow-hidden py-24">
    <Image
      src={localExhibidor}
      alt=""
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      widths={[640, 1400]}
      sizes="100vw"
    />
    <div class="absolute inset-0 -z-10 bg-borravino/90"></div>

    <div class="mx-auto max-w-2xl px-5 text-center">
      <TituloSeccion titulo="Contacto" epigrafe="Escribinos" claro />

      <p class="mt-8 text-lg text-balance text-crema">
        Contanos qué necesitás y te respondemos a la brevedad. Si es un regalo,
        decinos para quién es y nos encargamos del resto.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <Boton href={enlaceContacto('¡Hola! Te escribo desde la web.')} variante="claro" class="gap-2.5">
          <Icono nombre="whatsapp" class="h-5 w-5" />
          WhatsApp
        </Boton>
        <Boton
          href={SITIO.instagram}
          variante="contorno"
          class="gap-2.5 border-crema/50 text-crema hover:border-crema hover:bg-crema/10"
        >
          <Icono nombre="instagram" class="h-5 w-5" />
          Instagram
        </Boton>
        <Boton
          href={`mailto:${SITIO.email}`}
          variante="contorno"
          class="border-crema/50 text-crema hover:border-crema hover:bg-crema/10"
        >
          Mandar un mail
        </Boton>
      </div>

      <p class="mt-12 text-crema">¿Ya recibiste tus flores? Contanos qué te parecieron.</p>
      <Boton
        href={SITIO.resenaGoogle}
        variante="contorno"
        class="mt-5 gap-2.5 border-crema/50 text-crema hover:border-crema hover:bg-crema/10"
      >
        <Icono nombre="estrella" class="h-5 w-5" />
        Dejanos tu opinión en Google
      </Boton>
    </div>
  </section>
</Layout>
